// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// A competitor store a shop tracks, with what its last check found.
model Competitor {
  id            String    @id @default(cuid())
  shop          String
  url           String    // The store's origin, e.g. https://rival.com
  name          String
  isShopify     Boolean   @default(false)
  theme         String?
  apps          String    @default("[]") // JSON list of app names seen on the storefront
  adChannels    String    @default("[]") // JSON list of ad and analytics pixels seen
  productCount  Int       @default(0)
  avgPriceCents Int?
  currency      String?
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  // Search traffic from DataForSEO, refreshed weekly (lib/traffic).
  organicTraffic  Int?      // Estimated monthly visits from Google search
  organicKeywords Int?
  paidTraffic     Int?      // Estimated monthly visits from Google search ads
  paidKeywords    Int?
  paidCostCents   Int?      // Estimated monthly Google search ads spend, in US cents
  trafficMarket   String?   // Country the numbers are for, e.g. GB
  trafficAt       DateTime?
  trafficError    String?

  products  CompetitorProduct[]
  events    CompetitorEvent[]
  snapshots CompetitorSnapshot[]
  traffic   TrafficSnapshot[]
  keywords  CompetitorKeyword[]

  @@unique([shop, url])
  @@index([shop])
}

// One product on a competitor's storefront, as last seen.
model CompetitorProduct {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  productId    String
  handle       String
  title        String
  productType  String?
  priceCents   Int        // Lowest variant price
  compareAtCents Int?     // Highest compare-at price, when on sale
  publishedAt  DateTime?
  firstSeenAt  DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())
  removedAt    DateTime?

  @@unique([competitorId, productId])
}

// Something that changed at a competitor: a launch, a price change, a
// product taken down, or a new app or ad pixel.
model CompetitorEvent {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  kind         String     // launch | price_up | price_down | removed | app_added | app_removed | channel_added | channel_removed | theme_changed
  message      String
  createdAt    DateTime   @default(now())

  @@index([competitorId, createdAt])
}

// The competitor's numbers on each check, for trends.
model CompetitorSnapshot {
  id            String     @id @default(cuid())
  competitorId  String
  competitor    Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  takenAt       DateTime   @default(now())
  productCount  Int
  avgPriceCents Int?
  onSaleCount   Int        @default(0)

  @@index([competitorId, takenAt])
}

// A shop's settings: the country its traffic and keyword numbers are for.
model ShopSettings {
  shop   String @id
  market String @default("US")
}

// A competitor's search numbers on each traffic refresh, for trends.
model TrafficSnapshot {
  id              String     @id @default(cuid())
  competitorId    String
  competitor      Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  takenAt         DateTime   @default(now())
  market          String
  organicTraffic  Int
  organicKeywords Int
  paidTraffic     Int
  paidKeywords    Int
  paidCostCents   Int

  @@index([competitorId, takenAt])
}

// A competitor's top Google keywords, organic and paid, from the last refresh.
model CompetitorKeyword {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  keyword      String
  type         String     // organic | paid
  position     Int?
  searchVolume Int?
  traffic      Int?       // Estimated monthly visits from this keyword
  url          String?

  @@index([competitorId, type])
}
