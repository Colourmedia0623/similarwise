// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// A competitor store a shop tracks, with what its last check found.
model Competitor {
  id            String    @id @default(cuid())
  shop          String
  url           String    // The store's origin, e.g. https://rival.com
  name          String
  isShopify     Boolean   @default(false)
  theme         String?
  apps          String    @default("[]") // JSON list of app names seen on the storefront
  adChannels    String    @default("[]") // JSON list of ad and analytics pixels seen
  productCount  Int       @default(0)
  avgPriceCents Int?
  currency      String?
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  // Search traffic from DataForSEO, refreshed weekly (lib/traffic).
  organicTraffic  Int?      // Estimated monthly visits from Google search
  organicKeywords Int?
  paidTraffic     Int?      // Estimated monthly visits from Google search ads
  paidKeywords    Int?
  paidCostCents   Int?      // Estimated monthly Google search ads spend, in US cents
  top3Keywords    Int?      // Keywords ranking in Google's top three
  brandTerm       String?   // The name searched for, from their domain, e.g. foldabox
  brandedTraffic  Int?      // Monthly search visits from searches containing brandTerm
  trafficMarket   String?   // Country the numbers are for, e.g. GB
  trafficAt       DateTime?
  trafficError    String?

  // Keyword gap against the shop's own website, refreshed weekly (lib/traffic/gap).
  gapAt     DateTime?
  gapDomain String?   // The shop's website the gap was worked out against
  gapMarket String?
  gapError  String?

  // Ads in the Meta, TikTok and Google ad libraries, refreshed weekly (lib/ads).
  metaPageId       String?
  metaPageName     String?
  metaCandidates   String  @default("[]") // JSON [{id, name, likes}] from the last page search
  tiktokAdvertiser String?
  tiktokCandidates String  @default("[]") // JSON [name]
  adsAt            DateTime?
  adsMarket        String?
  adsError         String?

  // Sites linking to them but not the shop, refreshed weekly (lib/links).
  linksAt     DateTime?
  linksDomain String?   // The shop's website the gap was worked out against
  linksError  String?

  products  CompetitorProduct[]
  events    CompetitorEvent[]
  snapshots CompetitorSnapshot[]
  traffic   TrafficSnapshot[]
  keywords  CompetitorKeyword[]
  gaps      KeywordGap[]
  ads       CompetitorAd[]
  links     CompetitorLink[]
  matches   ProductMatch[]

  @@unique([shop, url])
  @@index([shop])
}

// One product on a competitor's storefront, as last seen.
model CompetitorProduct {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  productId    String
  handle       String
  title        String
  productType  String?
  priceCents   Int        // Lowest variant price
  compareAtCents Int?     // Highest compare-at price, when on sale
  publishedAt  DateTime?
  firstSeenAt  DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())
  removedAt    DateTime?
  matches      ProductMatch[]

  @@unique([competitorId, productId])
}

// Something that changed at a competitor: a launch, a price change, a
// product taken down, or a new app or ad pixel.
model CompetitorEvent {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  kind         String     // launch | price_up | price_down | removed | app_added | app_removed | channel_added | channel_removed | theme_changed
  message      String
  createdAt    DateTime   @default(now())

  @@index([competitorId, createdAt])
}

// The competitor's numbers on each check, for trends.
model CompetitorSnapshot {
  id            String     @id @default(cuid())
  competitorId  String
  competitor    Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  takenAt       DateTime   @default(now())
  productCount  Int
  avgPriceCents Int?
  onSaleCount   Int        @default(0)

  @@index([competitorId, takenAt])
}

// A shop's settings: the country its traffic and keyword numbers are for.
model ShopSettings {
  shop   String  @id
  market String  @default("US")
  domain String? // The shop's own website, for the keyword gap, e.g. giftbags.co.uk

  // The shop's own search traffic, to set beside competitors' (lib/traffic/channels).
  ownOrganicTraffic Int?
  ownPaidTraffic    Int?
  ownPaidCostCents  Int?
  ownTrafficDomain  String?
  ownTrafficMarket  String?
  ownTrafficAt      DateTime?

  // What the shop's own storefront runs, to set beside competitors' (lib/tracker/tech).
  ownTheme      String?
  ownApps       String    @default("[]")
  ownAdChannels String    @default("[]")
  ownTechDomain String?
  ownTechAt     DateTime?
  ownTechError  String?

  // Sites competing for the same Google searches (lib/traffic/similar), weekly.
  similarAt    DateTime?
  similarKey   String?   // The market and sites they were worked out from
  similarError String?

  // Emails (lib/email). alertEmail starts as the shop's email address.
  alertEmail   String?
  alertsOn     Boolean   @default(true)  // An email when competitors change
  alertTopics  String    @default("[\"prices\",\"products\",\"ads\",\"traffic\"]")
  digestOn     Boolean   @default(true)  // The Monday summary
  alertsSentAt DateTime? // Changes up to here have been emailed
  digestSentAt DateTime?

  // Content calendar (lib/ideas/calendar): planned posts go on the blog published, or as hidden drafts.
  calendarPublish Boolean @default(true)

  // AI mentions (lib/ai/mentions): the shop's questions asked of AI assistants weekly.
  aiCheckedAt DateTime? // The last finished check
  aiRunningAt DateTime? // Set while a check runs
  aiError     String?
  aiBrand     String? // The shop's name as people say it, e.g. Gift Boxes 3000

  // Social posting (lib/social): share each calendar article when it goes out.
  socialAuto Boolean @default(false)
}

// A competitor's search numbers on each traffic refresh, for trends.
model TrafficSnapshot {
  id              String     @id @default(cuid())
  competitorId    String
  competitor      Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  takenAt         DateTime   @default(now())
  market          String
  organicTraffic  Int
  organicKeywords Int
  paidTraffic     Int
  paidKeywords    Int
  paidCostCents   Int

  @@index([competitorId, takenAt])
}

// A competitor's top Google keywords, organic and paid, from the last refresh.
model CompetitorKeyword {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  keyword      String
  type         String     // organic | paid
  position     Int?
  searchVolume Int?
  traffic      Int?       // Estimated monthly visits from this keyword
  url          String?

  @@index([competitorId, type])
}

// A merchant's answers to the early-access survey on the public landing page.
// One row per email: answering again replaces the earlier answers.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  store     String?
  revenue   String
  tracking  String   // JSON list of how they watch competitors today
  features  String   // JSON list of up to three features they want most
  price     String
  question  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One of the shop's own products, copied from the Admin API so it can be
// matched against competitors' products (lib/prices).
model ShopProduct {
  id          String         @id @default(cuid())
  shop        String
  productId   String         // Admin API id, e.g. gid://shopify/Product/1
  handle      String
  title       String
  productType String?
  imageUrl    String?        // Its main photo on Shopify's CDN
  priceCents  Int            // Lowest variant price
  currency    String
  syncedAt    DateTime       @default(now())
  matches     ProductMatch[]

  @@unique([shop, productId])
  @@index([shop])
}

// Which product at a competitor is the same as one of the shop's own. A row
// with no competitor product means the merchant said there's no match, so
// suggestions don't bring one back.
model ProductMatch {
  id                  String             @id @default(cuid())
  shopProductId       String
  shopProduct         ShopProduct        @relation(fields: [shopProductId], references: [id], onDelete: Cascade)
  competitorId        String
  competitor          Competitor         @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  competitorProductId String?
  competitorProduct   CompetitorProduct? @relation(fields: [competitorProductId], references: [id], onDelete: Cascade)
  score               Float?             // Title similarity, for suggested matches
  confirmed           Boolean            @default(false) // Chosen or accepted by the merchant

  @@unique([shopProductId, competitorId])
  @@index([competitorId])
}

// A Google search a competitor ranks for: either one the shop's website
// doesn't rank for at all (yourPosition null), or one they both rank for.
model KeywordGap {
  id            String     @id @default(cuid())
  competitorId  String
  competitor    Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  keyword       String
  searchVolume  Int?
  cpcCents      Int?       // What advertisers pay per click, in US cents
  theirPosition Int?
  theirTraffic  Int?       // Their estimated monthly visits from this search
  theirUrl      String?
  yourPosition  Int?

  @@index([competitorId])
}

// An ad a competitor runs, as seen in a platform's public ad library.
model CompetitorAd {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  platform     String     // meta | tiktok | google
  adId         String
  title        String?
  text         String?
  imageUrl     String?
  videoUrl     String?
  linkUrl      String?    // Where the ad sends people
  adUrl        String?    // The ad in the platform's library
  cta          String?
  placements   String     @default("[]") // JSON, e.g. ["FACEBOOK","INSTAGRAM"]
  format       String?
  startedAt    DateTime?
  lastShownAt  DateTime?
  active       Boolean    @default(true)
  firstSeenAt  DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())

  @@unique([competitorId, platform, adId])
  @@index([competitorId, active])
}

// Where a website's visits come from and which countries they're from, from
// Similarweb's public figures through Apify (lib/traffic/sources). Shared by
// every shop that tracks the domain; refreshed weekly.
model SiteSources {
  domain    String   @id
  visits    Int?     // Average monthly visits, worldwide
  sources   String   @default("{}") // JSON channel -> share (0-1)
  countries String   @default("[]") // JSON [{ code, share }]
  engagement String?  // JSON Engagement: bounce rate, pages per visit, time on site, ranks, monthly visits
  fetchedAt DateTime
  error     String?
}

// Suggestions for winning searches from the keyword gap: which of the shop's
// pages should target each one, with a page title, meta description and
// opening paragraph Claude wrote for it (lib/ideas). Replaced as a set.
model KeywordIdea {
  id              String   @id @default(cuid())
  shop            String
  keyword         String
  searchVolume    Int?
  productId       String?  // Admin API id of the product to change; null for a new page
  pageKind        String   // product, collection, blog
  pageName        String
  seoTitle        String
  metaDescription String
  intro           String
  why             String
  createdAt       DateTime @default(now())

  @@index([shop])
}

// What competitors' running ads keep saying, and ad ideas for the shop's own
// products that Claude wrote from them (lib/ideas/ad-ideas). One set per
// shop, replaced each time; patterns and ideas are JSON.
model AdIdeas {
  shop      String   @id
  patterns  String   @default("[]")
  ideas     String   @default("[]")
  adsRead   Int      @default(0)
  createdAt DateTime @default(now())
}

// A website linking to a competitor that doesn't link to the shop, from
// DataForSEO Backlinks, refreshed weekly (lib/links).
model CompetitorLink {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  domain       String     // The linking website
  rank         Int?       // DataForSEO domain rank, 0 to 100
  backlinks    Int?       // Links from that site to the competitor
  firstSeen    DateTime?

  @@index([competitorId])
}

// A site that ranks for many of the same Google searches as the shop or its
// competitors, from DataForSEO, refreshed weekly (lib/traffic/similar).
model SimilarSite {
  id             String @id @default(cuid())
  shop           String
  domain         String
  sharedKeywords Int    // Searches it ranks for that the sites it's similar to also rank for
  traffic        Int?   // Its estimated monthly visits from Google search
  similarTo      String @default("[]") // JSON list of the sites it competes with ("you" for the shop)

  @@unique([shop, domain])
}

// A blog article Claude wrote for a keyword idea, kept here until the
// merchant sends it to their Shopify blog (lib/ideas/articles).
model BlogArticle {
  id              String    @id @default(cuid())
  shop            String
  keyword         String
  searchVolume    Int?
  title           String
  summary         String
  bodyHtml        String
  metaTitle       String
  metaDescription String
  tags            String    @default("[]") // JSON list
  status          String    @default("written") // written | draft | published
  shopifyId       String?   // Admin API id once it's on the blog
  url             String?   // Where it lives on the storefront
  error           String?
  createdAt       DateTime  @default(now())
  sentAt          DateTime?
  imageAlt        String?   // Set once an image is made (ArticleImage)
  imageError      String?

  @@index([shop])
}

// The picture made for a blog article, served at /images/<articleId>.jpg so
// Shopify can fetch it when the article is sent.
model ArticleImage {
  articleId String   @id
  shop      String
  mime      String   @default("image/jpeg")
  data      Bytes
  createdAt DateTime @default(now())

  @@index([shop])
}

// One day's post on the content calendar: written and sent to the shop's blog
// on its day by the hourly schedule.
model PlannedPost {
  id           String    @id @default(cuid())
  shop         String
  day          String    // YYYY-MM-DD, UTC
  keyword      String
  searchVolume Int?
  title        String
  angle        String    @default("")
  status       String    @default("planned") // planned | writing | done | failed
  claimedAt    DateTime? // When writing started, so a crashed run can be picked up again
  articleId    String?
  error        String?
  createdAt    DateTime  @default(now())

  @@index([shop, day])
  @@index([status, day])
}

// An outreach email to a site in the link gap (lib/links/outreach), sent by the
// merchant from their own mailbox, and where it got to.
model Outreach {
  id             String    @id @default(cuid())
  shop           String
  domain         String
  siteTitle      String?
  emails         String    @default("[]") // JSON list of addresses found on the site
  to             String?
  subject        String
  body           String
  status         String    @default("draft") // draft | sent | replied | linked | declined
  sentAt         DateTime?
  followUps      Int       @default(0)
  lastSentAt     DateTime? // The first email or the latest follow-up
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([shop, domain])
  @@index([shop])
}

// A question shoppers might ask an AI assistant, asked of each one weekly
// to see which shops it names (lib/ai/mentions).
model AiPrompt {
  id        String   @id @default(cuid())
  shop      String
  prompt    String
  createdAt DateTime @default(now())

  @@index([shop])
}

// One assistant's answer to one prompt on one check.
model AiAnswer {
  id       String   @id @default(cuid())
  shop     String
  promptId String
  platform String   // chat_gpt | gemini | perplexity
  ranAt    DateTime // The check it was part of
  text     String   @default("")
  brands   String   @default("[]") // JSON [{ key, position, cited }] for the shop ("you") and each competitor id named
  sources  String   @default("[]") // JSON [{ url, title, domain }] the answer cited
  error    String?

  @@index([shop, ranAt])
  @@index([promptId])
}

// A Facebook Page, Instagram business account or TikTok account the merchant
// connected, to post articles to (lib/social). Tokens are stored encrypted.
model SocialAccount {
  id             String    @id @default(cuid())
  shop           String
  network        String    // facebook | instagram | tiktok
  accountId      String    // Page id, Instagram user id or TikTok open_id
  name           String
  token          String    // Encrypted access token
  refreshToken   String?   // Encrypted (TikTok)
  tokenExpiresAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([shop, network, accountId])
}

// An article shared to one social account.
model SocialPost {
  id        String    @id @default(cuid())
  shop      String
  articleId String
  accountId String    // SocialAccount.id
  network   String
  caption   String
  status    String    // posted | failed | processing
  remoteId  String?
  url       String?
  error     String?
  createdAt DateTime  @default(now())

  @@index([shop, articleId])
}
